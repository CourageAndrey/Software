<UserControl x:Class="Software.WebBrowser.BrowserTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Loaded="Tab_Loaded">
    <UserControl.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" IsEnabled="False"
                        Click="Back_Click" ToolTip="Back" AutomationProperties.Name="Back" />
                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" IsEnabled="False"
                        Click="Forward_Click" ToolTip="Forward" AutomationProperties.Name="Forward" />
                <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;" IsEnabled="False"
                        Click="Reload_Click" ToolTip="Reload" AutomationProperties.Name="Reload or stop" />
                <Button x:Name="HomeButton" Style="{StaticResource IconButton}" Content="&#xE80F;" IsEnabled="False"
                        Click="Home_Click" ToolTip="Home" AutomationProperties.Name="Home" />
            </StackPanel>
            <TextBox x:Name="AddressBox" Grid.Column="1" Margin="5,0" Padding="6,4" VerticalContentAlignment="Center"
                     IsEnabled="False" KeyDown="Address_KeyDown" AutomationProperties.Name="Address or search"
                     ToolTip="Address or search" />
            <Button x:Name="GoButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72A;" IsEnabled="False"
                    Click="Go_Click" ToolTip="Go" AutomationProperties.Name="Go" />
        </Grid>
        <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
        <DockPanel Grid.Row="2" Background="#F3F4F6">
            <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="Retry" Click="Retry_Click" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Text="Starting browser..." Margin="8,4" FontSize="12" Foreground="#4B5563"
                       TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>