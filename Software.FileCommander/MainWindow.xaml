<Window x:Class="Software.FileCommander.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:Software.FileCommander"
		Title="File Commander" Height="780" Width="1240" MinHeight="450" MinWidth="900"
		FontFamily="Segoe UI" Background="#F3F4F6" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
	<Window.Resources>
		<Style TargetType="Button">
			<Setter Property="Padding" Value="12,7" />
			<Setter Property="Margin" Value="3,0" />
			<Setter Property="Background" Value="White" />
			<Setter Property="BorderBrush" Value="#D1D5DB" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
	</Window.Resources>
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid x:Name="PaneHost" Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" MinWidth="350" />
				<ColumnDefinition Width="7" />
				<ColumnDefinition Width="*" MinWidth="350" />
			</Grid.ColumnDefinitions>
			<local:TabbedPane x:Name="LeftPane" />
			<GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
							Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
			<local:TabbedPane x:Name="RightPane" Grid.Column="2" />
		</Grid>
		<UniformGrid x:Name="CommandBar" Grid.Row="1" Rows="1" Margin="0,10,0,8">
			<Button Tag="{x:Static local:FileCommand.Rename}" Click="Command_Click">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8AC;" Margin="0,0,7,0" VerticalAlignment="Center" />
					<TextBlock Text="F2 Rename" />
				</StackPanel>
			</Button>
			<Button Tag="{x:Static local:FileCommand.Copy}" Click="Command_Click">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" Margin="0,0,7,0" VerticalAlignment="Center" />
					<TextBlock Text="F5 Copy" />
				</StackPanel>
			</Button>
			<Button Tag="{x:Static local:FileCommand.Move}" Click="Command_Click">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8DE;" Margin="0,0,7,0" VerticalAlignment="Center" />
					<TextBlock Text="F6 Move" />
				</StackPanel>
			</Button>
			<Button Tag="{x:Static local:FileCommand.NewFolder}" Click="Command_Click">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8F4;" Margin="0,0,7,0" VerticalAlignment="Center" />
					<TextBlock Text="F7 New folder" />
				</StackPanel>
			</Button>
			<Button Tag="{x:Static local:FileCommand.Delete}" Click="Command_Click">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" Margin="0,0,7,0" VerticalAlignment="Center" />
					<TextBlock Text="F8 Delete" />
				</StackPanel>
			</Button>
		</UniformGrid>
		<DockPanel Grid.Row="2">
			<ProgressBar x:Name="BusyProgress" DockPanel.Dock="Right" Width="110" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="12,0,0,0" />
			<TextBlock x:Name="OperationStatus" Text="Ready" Foreground="#4B5563" TextWrapping="Wrap" VerticalAlignment="Center" />
		</DockPanel>
	</Grid>
</Window>
