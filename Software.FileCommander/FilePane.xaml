<UserControl x:Class="Software.FileCommander.FilePane"
				xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				PreviewMouseDown="Pane_Activated" GotKeyboardFocus="Pane_Activated">
	<UserControl.Resources>
		<Style x:Key="NavigationButton" TargetType="Button">
			<Setter Property="FontFamily" Value="Segoe Fluent Icons" />
			<Setter Property="Width" Value="30" />
			<Setter Property="Height" Value="30" />
			<Setter Property="Margin" Value="2,0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="White" />
			<Setter Property="BorderBrush" Value="#D1D5DB" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
	</UserControl.Resources>
	<Border x:Name="PaneBorder" BorderBrush="#D1D5DB" BorderThickness="2" Background="White">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<DockPanel x:Name="NavigationBar" Margin="7">
				<Button DockPanel.Dock="Right" Style="{StaticResource NavigationButton}" Content="&#xE72C;" Click="Refresh_Click"
						ToolTip="Refresh folder" AutomationProperties.Name="Refresh folder" />
				<Button DockPanel.Dock="Right" Style="{StaticResource NavigationButton}" Content="&#xE74A;" Click="Up_Click"
						ToolTip="Parent folder" AutomationProperties.Name="Parent folder" />
				<ComboBox x:Name="DriveSelector" Width="75" Margin="0,0,7,0" SelectionChanged="Drive_Changed" AutomationProperties.Name="Drive" />
				<TextBox x:Name="PathBox" Padding="5" VerticalContentAlignment="Center" KeyDown="Path_KeyDown"
							AutomationProperties.Name="Folder path" />
			</DockPanel>
			<ListView x:Name="FileList" Grid.Row="1" SelectionMode="Extended" BorderThickness="0,1,0,1" BorderBrush="#D1D5DB"
						MouseDoubleClick="File_DoubleClick" KeyDown="File_KeyDown" SelectionChanged="Selection_Changed"
						ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Files">
				<ListView.View>
					<GridView>
						<GridViewColumn Header="Name" Width="260">
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal">
										<Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" UseLayoutRounding="True"
												RenderOptions.BitmapScalingMode="HighQuality" />
										<TextBlock Text="{Binding Name}" />
									</StackPanel>
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>
						<GridViewColumn Header="Size" Width="85" DisplayMemberBinding="{Binding DisplaySize}" />
						<GridViewColumn Header="Modified" Width="145" DisplayMemberBinding="{Binding Modified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
					</GridView>
				</ListView.View>
			</ListView>
			<TextBlock x:Name="PaneStatus" Grid.Row="2" Margin="8,6" FontSize="12" Foreground="#4B5563" TextWrapping="Wrap" />
		</Grid>
	</Border>
</UserControl>