<UserControl x:Class="Software.FileCommander.TabbedPane"
				xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				PreviewMouseDown="Strip_PreviewMouseDown">
	<UserControl.Resources>
		<Style x:Key="TabButton" TargetType="Button">
			<Setter Property="FontFamily" Value="Segoe Fluent Icons" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
	</UserControl.Resources>
	<DockPanel>
		<TabControl x:Name="TabStrip" DockPanel.Dock="Top" SelectionChanged="Tab_SelectionChanged" AutomationProperties.Name="Folder tabs">
			<TabControl.Template>
				<ControlTemplate TargetType="TabControl">
					<DockPanel>
						<Button DockPanel.Dock="Right" Style="{StaticResource TabButton}" Content="&#xE710;" FontSize="12" Width="26" Height="22"
								Click="NewTab_Click" ToolTip="New tab (Ctrl+T)" AutomationProperties.Name="New tab" />
						<TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
					</DockPanel>
				</ControlTemplate>
			</TabControl.Template>
		</TabControl>
		<Grid x:Name="PaneStack" />
	</DockPanel>
</UserControl>
