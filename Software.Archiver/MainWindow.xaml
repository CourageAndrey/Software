<Window x:Class="Software.Archiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Software.Archiver"
        Title="Archiver" Height="740" Width="1120" MinHeight="500" MinWidth="820"
        FontFamily="Segoe UI" Background="#F3F4F6" Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFB" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF0F2" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel x:Name="Toolbar" Margin="0,0,0,10">
            <TextBlock Text="Archiver" FontSize="18" FontWeight="SemiBold" Margin="0,0,22,0" VerticalAlignment="Center" Foreground="#111827" />
            <StackPanel Orientation="Horizontal">
                <Button Click="Open_Click" ToolTip="Open archive">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8E5;" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="Open" /></StackPanel>
                </Button>
                <Button Click="New_Click" ToolTip="New ZIP archive">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="New archive" /></StackPanel>
                </Button>
                <Button x:Name="ExtractAllButton" Click="ExtractAll_Click" IsEnabled="False" ToolTip="Extract all entries">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="Extract all" /></StackPanel>
                </Button>
                <Button x:Name="ExtractSelectedButton" Click="ExtractSelected_Click" IsEnabled="False" ToolTip="Extract selected entries">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B5;" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="Extract selected" /></StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
        <DockPanel x:Name="ArchiveHeader" Grid.Row="1" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Password" VerticalAlignment="Center" Margin="12,0,8,0" />
                <PasswordBox x:Name="ArchivePassword" Width="160" Padding="5" ToolTip="Password for opening or extracting encrypted archives" />
            </StackPanel>
            <TextBlock x:Name="ArchivePath" Text="No archive open" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#4B5563" />
        </DockPanel>
        <TabControl x:Name="Workspace" Grid.Row="2">
            <TabItem Header="Archive contents">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="FilterBox" Padding="5" TextChanged="Filter_Changed" AutomationProperties.Name="Filter archive entries" />
                    </DockPanel>
                    <DataGrid x:Name="EntryList" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                              SelectionChanged="EntrySelection_Changed" CanUserAddRows="False" AutomationProperties.Name="Archive contents">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" SortMemberPath="Size" Width="120" />
                            <DataGridTextColumn Header="Packed" Binding="{Binding DisplayPackedSize}" SortMemberPath="PackedSize" Width="120" />
                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Create ZIP">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Click="AddFiles_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="Add files" /></StackPanel></Button>
                        <Button Click="AddFolder_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8F4;" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="Add folders" /></StackPanel></Button>
                        <Button Click="Remove_Click" ToolTip="Remove selected inputs" AutomationProperties.Name="Remove selected inputs"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE738;" /></Button>
                    </StackPanel>
                    <ListBox x:Name="InputList" Grid.Row="1" SelectionMode="Extended" BorderBrush="#D1D5DB" AutomationProperties.Name="Archive inputs" />
                    <Grid Grid.Row="2" Margin="0,10,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Output ZIP" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox x:Name="OutputPath" Grid.Column="1" Padding="5" AutomationProperties.Name="Output ZIP path" />
                        <Button Grid.Column="2" Click="OutputBrowse_Click" ToolTip="Choose output archive" AutomationProperties.Name="Choose output archive"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" /></Button>
                    </Grid>
                    <DockPanel Grid.Row="3">
                        <Button DockPanel.Dock="Right" Click="Create_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74E;" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="Create ZIP" /></StackPanel></Button>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Compression" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox x:Name="Compression" Width="160" SelectedIndex="0" VerticalAlignment="Center" AutomationProperties.Name="Compression level">
                                <ComboBoxItem Content="Normal" Tag="Optimal" />
                                <ComboBoxItem Content="Fast" Tag="Fastest" />
                                <ComboBoxItem Content="Maximum" Tag="SmallestSize" />
                                <ComboBoxItem Content="Store" Tag="NoCompression" />
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#4B5563" Margin="0,0,12,0" />
            <ProgressBar x:Name="OperationProgress" Grid.Column="1" Height="7" Minimum="0" Maximum="100" />
            <Button x:Name="CancelButton" Grid.Column="2" IsEnabled="False" Click="Cancel_Click" ToolTip="Cancel current operation" AutomationProperties.Name="Cancel current operation"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" /></Button>
        </Grid>
    </Grid>
</Window>
