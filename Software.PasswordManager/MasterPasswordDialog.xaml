<Window x:Class="Software.PasswordManager.MasterPasswordDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Master password" Width="420" SizeToContent="Height" ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" Closed="Window_Closed">
	<StackPanel Margin="20">
		<TextBlock Text="Master password" Margin="0,0,0,7" />
		<PasswordBox x:Name="MasterPassword" Padding="7" MaxLength="1024" />
		<StackPanel x:Name="ConfirmationArea" Margin="0,12,0,0">
			<TextBlock Text="Confirm master password" Margin="0,0,0,7" />
			<PasswordBox x:Name="Confirmation" Padding="7" MaxLength="1024" />
			<TextBlock Text="Minimum 12 characters. No password recovery." Margin="0,10,0,0" Foreground="#92400E" TextWrapping="Wrap" />
		</StackPanel>
		<TextBlock x:Name="ErrorText" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,12,0,0" />
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button x:Name="AcceptButton" Content="Unlock" IsDefault="True" Click="Accept_Click" MinWidth="90" Padding="12,6" Margin="0,0,8,0" />
			<Button Content="Cancel" IsCancel="True" MinWidth="90" Padding="12,6" />
		</StackPanel>
	</StackPanel>
</Window>